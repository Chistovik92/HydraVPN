    <!-- Tunnel info -->
    <string name="tunnel_sstp_l2tp">纯 Kotlin，无原生 .aar：PPP 协议栈（LCP、MS-CHAPv2、IPCP），基于 TLS 的 SSTP（带 crypto-binding），基于 UDP 的 L2TP（无 IPsec/ESP）。需要在设备上测试。</string>
    <string name="tunnel_pptp">不可用：GRE（IP 协议 47）需要原始套接字/root，且该协议栈已从 Android 12/13 移除。替代方案：SSTP、L2TP、WireGuard。</string>
    <string name="tunnel_xray">传输：XTLS Vision / WS / gRPC。Flow：xtls-rprx-vision。引擎：libXray.aar。</string>
    <string name="tunnel_singbox">协议：VLESS、VMess、Trojan、Shadowsocks、Hysteria2、TUIC v5。引擎：libbox.aar。</string>
    <string name="tunnel_wg">普通 WireGuard 通过 sing-box（libbox.aar）运行。AmneziaWG 1.0/1.5/2.0 使用自己的引擎 amneziawg-go.aar：Jc/Jmin/Jmax/S1/S2/H1–H4 混淆和 I1–I5 标记。.conf/uapi 生成已就绪。</string>
    <string name="tunnel_beta">实验性引擎。WDTT — 经由 VK 云 TURN 中继的 WireGuard（libclient.so + VK 登录）。olcRTC — 基于 WebRTC DataChannel 的 TCP（olcrtc.aar + tun2socks）。界面中带有 BETA 标记。</string>
    <string name="xray_toggle_title">Xray Core 用于 VLESS/VMess/Trojan/SS</string>
    <string name="xray_toggle_desc">代替 sing-box — 为了使用其 XTLS Vision 实现（独立进程，sing-box 仍作为 TUN 桥接）。VLESS 已在真机验证；VMess/Trojan/SS 及长期稳定性尚未验证。</string>
    <string name="xray_toggle_missing">需要 app/libs/libXray.aar — 见 docs/BUILD.md 第 2.2 节。</string>

    <!-- Security -->
    <string name="sec_killswitch_desc">连接尝试失败时，隧道不会退回直连 — 流量会被阻断，直到你手动断开 VPN。它无法防止系统撤销 VPN（其他 VPN 应用、系统设置中的“断开”）— 如需系统级完全保障，请在下方开启“阻止未使用 VPN 的连接”。</string>
    <string name="sec_auto_app">启动应用时自动连接</string>
    <string name="sec_auto_app_desc">打开 Hydra 即连接到上次使用的服务器（前提是之前已授予 VPN 权限）。</string>
    <string name="sec_auto_boot">开机时自动连接</string>
    <string name="sec_auto_boot_desc">手机重启后无需打开应用即建立隧道。同样需要之前已授予的 VPN 权限 — 无法从后台显示对话框。</string>
    <string name="sec_tile_title">快速设置磁贴</string>
    <string name="sec_tile_desc">在快速设置面板中显示当前连接的位置。点按打开应用。</string>
    <string name="sec_tile_add">添加磁贴 →</string>
    <string name="sec_tile_manual">如何手动添加 →</string>
    <string name="sec_always_on_title">系统始终开启的 VPN</string>
    <string name="sec_always_on_desc">唯一能保证在应用或服务本身崩溃时（而不仅是连接失败时）也阻断流量的方式。设置 → 网络 → VPN → Hydra → 齿轮 → “始终开启的 VPN” + “阻止未使用 VPN 的连接”。</string>
    <string name="sec_open_vpn_settings">打开 VPN 设置 →</string>

