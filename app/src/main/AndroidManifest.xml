<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Автозапуск после перезагрузки (опционально) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Android TV и устройства без сенсорного экрана/камеры (Фаза 8): ни одна из этих
         возможностей не обязательна — иначе магазины прячут приложение на TV, а камера
         (QR-сканер ZXing тянет разрешение CAMERA) по умолчанию считалась бы обязательной. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Видимость пакетов (Android 11+): без этого queryIntentActivities в экране
         раздельного туннелирования возвращает лишь горстку приложений, и выбрать
         в списке почти нечего. Запрос по launcher-интенту не требует
         QUERY_ALL_PACKAGES — видны все приложения с ярлыком в лаунчере. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".HydraApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hydra"
        android:usesCleartextTraffic="false"
        android:banner="@drawable/tv_banner"
        android:localeConfig="@xml/locales_config"
        android:extractNativeLibs="true">
        <!-- extractNativeLibs="true": без этого AGP не распаковывает .so на
             диск (грузит их прямо из APK служебным механизмом системного
             classloader'а) — а нашему собственному DexClassLoader в
             XrayEngineService (см. docs/BUILD.md, раздел 2.2) для
             libgojni.so нужен реальный файл в nativeLibraryDir, иначе
             System.loadLibrary("gojni") не находит его (UnsatisfiedLinkError). -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.Hydra">
            <!-- Ярлык на рабочем столе даёт не сама активность, а activity-alias
                 ниже: так иконку можно менять вместе с темой (см. LauncherIcon). -->
            <!-- Импорт по клику на vless:// vmess:// и т.п. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vless" />
                <data android:scheme="vmess" />
                <data android:scheme="trojan" />
                <data android:scheme="ss" />
                <data android:scheme="hysteria2" />
                <data android:scheme="tuic" />
                <data android:scheme="wireguard" />
                <data android:scheme="awg" />
                <data android:scheme="sstp" />
                <data android:scheme="l2tp" />
                <data android:scheme="pptp" />
                <data android:scheme="sing-box" />
                <data android:scheme="olcrtc" />
                <data android:scheme="openflux" />
                <data android:scheme="olcbox" />
            </intent-filter>
            <!-- Android TV (Фаза 8): в лаунчер TV попадает сама активность — ярлыки-alias
                 ниже переключаются вместе с иконкой и на TV пропадали бы. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- «Поделиться» ссылкой/текстом/картинкой с QR из другого приложения (0.6.18). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- Ярлыки. Всегда включён ровно один: по умолчанию Cyber Emerald.
             Переключение — LauncherIcon.apply(), тумблер в Настройках. -->
        <activity-alias
            android:name=".LauncherAmbient"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".LauncherStealth"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_stealth"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".LauncherOcean"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_ocean"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".LauncherAmber"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_amber"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>

        <!-- Отдаёт картинку QR другим приложениям при «Поделиться» (0.6.18+). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Собственно VPN-туннель (Xray / sing-box) -->
        <service
            android:name=".vpn.HydraVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn" />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- Автоподключение при загрузке устройства (Фаза 6b, тумблер в
             Настройках → Безопасность, выключен по умолчанию). exported=true
             обязателен для системных broadcast-приёмников на API 31+ —
             BOOT_COMPLETED защищён ОС, сторонние приложения послать его не могут. -->
        <receiver
            android:name=".vpn.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Виджет на рабочем столе (Фаза 8): локация, статус, кнопка подключения. -->
        <receiver
            android:name=".vpn.HydraWidget"
            android:exported="false"
            android:label="Hydra VPN">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_vpn_info" />
        </receiver>

        <!-- Плитка «Hydra VPN» в шторке быстрых настроек (Фаза 6b). -->
        <service
            android:name=".vpn.HydraQsTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_vpn"
            android:label="Hydra VPN"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Xray-core (libXray.aar) — в ОТДЕЛЬНОМ процессе: gomobile-сборки
             libbox и libXray каждая тащит свой Go-рантайм, а Go не поддерживает
             два независимо собранных рантайма в одном процессе (см. docs/BUILD.md,
             раздел 2.2, и README github.com/XTLS/libXray). XrayCore (main-процесс,
             HydraVpnService) общается с этим сервисом через AIDL (IXrayEngine) —
             только строки/ParcelFileDescriptor, без Go-типов через границу. -->
        <service
            android:name=".vpn.core.xray.XrayEngineService"
            android:process=":xray"
            android:exported="false" />

    </application>
</manifest>
